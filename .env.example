# Supabase PostgreSQL connection (set these in Render Environment settings)
DB_HOST=your-project-db-host.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace-with-a-rotated-password
DB_SSL=true

# Optional: pin to one public.mcp row id. If omitted, highest id with Cur_mcp_api is used.
# UPSTREAM_ROW_ID=1

# Optional tuning
UPSTREAM_TIMEOUT_MS=120000
MAX_BODY_BYTES=10485760

# Keep false for production. Only enable for a trusted upstream that has no HTTPS.
ALLOW_HTTP_UPSTREAM=false
